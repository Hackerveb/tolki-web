# =============================================================================
# TolKI Web App - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication (https://clerk.com)
# -----------------------------------------------------------------------------
# Publishable key (safe for browser) - from Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Secret key (server-only) - from Clerk Dashboard > API Keys
CLERK_SECRET_KEY=sk_live_...

# Auth route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# -----------------------------------------------------------------------------
# Convex Database (https://convex.dev)
# -----------------------------------------------------------------------------
# Convex deployment URL - from Convex Dashboard > Settings
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Convex deploy key (server-only) - from Convex Dashboard > Settings > Deploy Key
# Used by the Stripe webhook to call Convex mutations server-side
CONVEX_DEPLOY_KEY=prod:your-project|...

# -----------------------------------------------------------------------------
# LiveKit Voice (https://livekit.io)
# -----------------------------------------------------------------------------
# LiveKit Cloud WebSocket URL - from LiveKit Cloud Dashboard > Settings
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API credentials (server-only) - from LiveKit Cloud Dashboard > Settings
# Used to generate participant access tokens
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Stripe Payments (https://stripe.com)
# -----------------------------------------------------------------------------
# Publishable key (safe for browser) - from Stripe Dashboard > Developers > API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Secret key (server-only) - from Stripe Dashboard > Developers > API Keys
# Use restricted key (rk_live_) with only checkout.session permissions for production
STRIPE_SECRET_KEY=sk_live_...

# Webhook signing secret - from Stripe Dashboard > Developers > Webhooks > Signing secret
# Required to verify webhook payloads. Create a webhook endpoint pointing to:
#   https://your-domain.com/api/stripe/webhook
# Events to listen for: checkout.session.completed, checkout.session.expired, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of the deployed app (used for Stripe redirect URLs)
# CRITICAL: Must match your actual deployment URL including https://
NEXT_PUBLIC_URL=https://your-domain.com
